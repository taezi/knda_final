# Local backend settings template. Copy this file to .env and fill in your own values.
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173

# Naver Search API credentials (keep the real values in backend/.env only)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Codex CLI is optional and should stay disabled in deployment environments.
CODEX_CLI_ENABLED=false
CODEX_CLI_COMMAND=codex
CODEX_NODE_DIRECTORY=
CODEX_CLI_WORKING_DIRECTORY=
CODEX_CLI_TIMEOUT_SECONDS=90
